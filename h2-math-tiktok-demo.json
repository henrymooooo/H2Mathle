    "HCI-2025-P2-Q5": {
      "flaggedParts": [],
      "flaggedAt": null,
      "entries": [
        {
          "id": "demo-hci-pnc-1",
          "kind": "mistake",
          "part": "(a)(ii)",
          "tags": [
            "Conceptual Gap",
            "Misread Question"
          ],
          "text": "\"N's together OR I's separated\" is inclusive OR ($A \\cup B$): computed $n(A) + n(B)$ and forgot to subtract the overlap $n(A \\cap B)$ where NN is grouped as 1 unit and the 3 I's are slotted between the 8 remaining units.",
          "updatedAt": "23/11/2026"
        }
