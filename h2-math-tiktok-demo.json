    "RI-2025-P2-Q7": {
      "flaggedParts": [],
      "flaggedAt": null,
      "entries": [
        {
          "id": "demo-ri-norm-1",
          "kind": "mistake",
          "part": "(b)",
          "tags": [
            "GC Error",
            "Conceptual Gap"
          ],
          "text": "Mixed up $2R$ vs $R_1 + R_2$: two independent packets have $\\mathrm{Var}(R_1 + R_2) = 2\\mathrm{Var}(R) = 18$, NOT $2^2\\mathrm{Var}(R) = 36$. Total $T \\sim \\mathrm{N}(560, 66)$, so pass $\\sigma = \\sqrt{66}$ into GC `normalcdf`.",
          "updatedAt": "23/11/2026"
        }
      ]
    },
    "EJC-2026-P1-Q7": {
      "flaggedParts": [],
      "flaggedAt": null,
      "entries": [
        {
          "id": "demo-ejc-diff-1",
          "kind": "mistake",
          "part": "(a)",
          "tags": [
            "Algebra Slip"
          ],
          "text": "Sign/power slip differentiating $h = \\frac{k}{\\pi r^2} - \\frac{2}{3}r$: $\\frac{\\mathrm{d}h}{\\mathrm{d}r} = -\\frac{2k}{\\pi r^3} - \\frac{2}{3}$ (forgot negative sign on $r^{-2}$ initially). Remember hemisphere volume is $\\frac{2}{3}\\pi r^3$, curved SA is $2\\pi r^2$.",
          "updatedAt": "22/11/2026"
        }
      ]
    },
    "ACJC-2025-P1-Q8": {
      "flaggedParts": [],
      "flaggedAt": null,
      "entries": [
        {
          "id": "demo-acjc-fn-1",
          "kind": "note",
          "part": "(a)(iii)",
          "tags": [],
          "text": "Stepwise replacement check from $y = \\mathrm{f}(2x + 1) \\to y = \\mathrm{f}(x)$: 1) Scale parallel to $x$-axis by factor $2$ ($x \\mapsto \\frac{x}{2}$, giving $\\mathrm{f}(x+1)$). 2) Translate $1$ unit in positive $x$-direction ($x \\mapsto x - 1$, giving $\\mathrm{f}(x)$).",
          "updatedAt": "22/11/2026"
        }
      ]
    },
    "TJC-2025-P2-Q10": {
      "flaggedParts": [],
      "flaggedAt": null,
      "entries": [
        {
          "id": "demo-tjc-corr-1",
          "kind": "note",
          "part": "(f)",
          "tags": [],
          "text": "PMCC $r$ is invariant under positive linear scaling ($aX + b$, $a > 0$), so converting distance $x$ from miles to km ($\\times 1.609$) leaves $r$ unchanged.",
          "updatedAt": "23/11/2026"
        }
      ]
    }
